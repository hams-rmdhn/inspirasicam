{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InspirasiCam",
  "version": "0.2.0",
  "identifier": "com.inspirasicam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "InspirasiCam",
        "width": 270,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "resizable": true,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "media-src": "'self' blob: mediadevices:",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Video",
    "shortDescription": "Floating rectangle camera overlay",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
